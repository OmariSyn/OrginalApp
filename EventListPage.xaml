<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPNavigation_APP.EventListPage">
    <VerticalStackLayout Padding="20">
        <Label Text="Event List" FontSize="24" HorizontalOptions="Center" />
        <Button Text="View All Events" Clicked="OnViewAllEventsClicked" />
        <Button Text="View My Events" Clicked="OnViewMyEventsClicked" />
        <Button Text="Add Event" Clicked="OnAddEventClicked" />
    </VerticalStackLayout>
</ContentPage>