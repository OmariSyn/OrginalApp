<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPNavigation_APP.LoginPage">
    <VerticalStackLayout Padding="20">
        <Entry Placeholder="Username" x:Name="UsernameEntry" />
        <Entry Placeholder="Password" x:Name="PasswordEntry" IsPassword="True" />
        <Button Text="Log In" Clicked="OnLoginClicked" />
        <Button Text="Log In as Guest" Clicked="OnGuestLoginClicked" />
    </VerticalStackLayout>
</ContentPage>